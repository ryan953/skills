<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- Run through bash: dotagents installs skill files by copy and the
         executable bit is not worth depending on. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__RUNNER__</string>
    </array>

    <!-- Only Minute set => runs every hour at :__MINUTE__. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>

    <!-- Missed runs (asleep/off) collapse into a single run on wake. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/janitor.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/janitor.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
